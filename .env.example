# LOCUS — environment variables for local development.
#
# All VITE_-prefixed variables are bundled into the client and PUBLIC by
# design. Do NOT add anything secret here. Server-side secrets (OpenAI,
# Anthropic, Halyk, Resend, etc.) live only in Supabase Edge Function env.

# Supabase project URL — public, embedded in the client
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon (publishable) key — public, intentional. RLS gates access.
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# VAPID public key for Web Push subscriptions — public by spec
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here
